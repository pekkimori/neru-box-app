# Public values only. Copy to .env.local for development.
# Physical device: use the computer's LAN address, on the same network.
# Android emulator: http://10.0.2.2:3007
# iOS simulator or web on the same computer: http://localhost:3007
EXPO_PUBLIC_API_URL=http://localhost:3007

# Optional Google login. The server GOOGLE_CLIENT_ID must match this WEB ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Native application identities registered in your Google Cloud project.
NERU_ANDROID_PACKAGE=
NERU_IOS_BUNDLE_IDENTIFIER=
